{
  "name": "delta-force-container-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "config:convert": "node tools/config-converter.js",
    "config:template": "node tools/config-converter.js --template",
    "config:excel": "node tools/config-converter.js --excel",
    "xlsx:create": "node tools/xlsx-converter.js create-templates",
    "xlsx:convert": "node tools/xlsx-converter.js convert",
    "xlsx:all": "node tools/xlsx-converter.js all",
    "layout:editor": "open tools/layout-editor.html",
    "deploy:github": "./deploy-github.sh",
    "deploy:server": "./deploy-server.sh",
    "docker:build": "docker build -t delta-force-simulator .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "start:prod": "NODE_ENV=production npm run build && npm run preview"
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.1",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "sass": "^1.77.0",
    "typescript": "^5.2.2",
    "vite": "^6.0.0"
  }
}
